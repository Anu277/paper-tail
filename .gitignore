# --- backend (Python / uv) ---
backend/.venv/
__pycache__/
*.pyc
backend/.env

# generated ingestion output — downloaded PDFs, FAISS/BM25 indexes,
# citation graph, metadata store. Regenerated by scripts/*.py or the
# Add Papers flow, not source code; the old "data/index/" pattern here
# never matched the real folder name ("data/indexes/", plural) — this
# replaces it with the whole directory instead of a fragile subpath.
backend/data/
*.faiss
*.pkl

# --- frontend (Vite / TanStack Start) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.output/
frontend/.vinxi/
frontend/.tanstack/
frontend/.nitro/
frontend/.env
*.local

# --- tooling / OS ---
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
